{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2023", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
		"jsx": "react-jsx",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"types": ["vite/client", "node"],
		"noEmit": true
	},
	"include": ["src", "tests", "e2e", "*.config.ts"]
}
