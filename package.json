{
  "name": "pcb-viewer",
  "version": "1.0.0",
  "description": "A browser viewer for Altium Designer projects: schematics, PCB and 3D, any commit of a GitHub repo, and side-by-side commit diffs.",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test:corpus": "vitest run --config vitest.corpus.config.ts",
    "postinstall": "patch-package",
    "e2e": "playwright test",
    "index": "node tools/build-index.mjs public/index shivam6279/PCB=../../PCB"
  },
  "author": "Shivam Sharma",
  "license": "MIT",
  "type": "module",
  "private": "true",
  "dependencies": {
    "altiumts": "0.0.87",
    "clipper-lib": "^6.4.2",
    "comlink": "^4.4.2",
    "earcut": "^3.2.4",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.49.0",
    "occt-import-js": "^0.0.23",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.15",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/react": "^16.3.3",
    "@types/clipper-lib": "^6.4.0",
    "@types/earcut": "^3.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "hersheytext": "^2.0.0",
    "jsdom": "^30.1.1",
    "patch-package": "^8.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "altiumts": {
      "typescript": "$typescript"
    }
  }
}
